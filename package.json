{
  "name": "sigres",
  "version": "1.0.0",
  "private": true,
  "description": "SIGRES — Sistema de Gestão do Cronograma de Coleta de Resíduos Sólidos de Itapuã do Oeste/RO",
  "type": "module",
  "scripts": {
    "start": "serve . --listen 8080",
    "lint": "eslint . && html-validate \"*.html\"",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.js\"",
    "senha": "node scripts/gerar-hash-senha.js",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "coleta de resíduos",
    "prefeitura",
    "itapuã do oeste",
    "gestão pública",
    "extensão universitária"
  ],
  "author": "Elton Portugal",
  "repository": {
    "type": "git",
    "url": "https://github.com/EltonPortugal/SIGRES.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "html-validate": "^11.21.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.7"
  }
}
